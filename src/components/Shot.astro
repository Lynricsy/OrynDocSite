---
// 正文截图：按 id 查找 src/assets/shots/<id>-light.webp 与可选的 <id>-dark.webp，
// 两张都在时随站点明暗主题切换。Starlight 没有按主题切换正文图片的组件。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	alt: string;
	caption?: string;
}

const { id, alt, caption } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/**/*.webp', {
	eager: true,
});
const pick = (variant: 'light' | 'dark') => shots[`../assets/shots/${id}-${variant}.webp`]?.default;
const light = pick('light');
const dark = pick('dark');
if (!light) {
	throw new Error(`<Shot>: 找不到截图「${id}」（src/assets/shots/${id}-light.webp）`);
}
const widths = [640, 960, 1280, Math.min(light.width, 1920)].filter((w) => w <= light.width);
const sizes = '(min-width: 72rem) 46rem, 100vw';
---

<figure class:list={['oryn-shot', { 'single': !dark }]}>
	<Image src={light} alt={alt} widths={widths} sizes={sizes} class="light" />
	{dark && <Image src={dark} alt={alt} widths={widths} sizes={sizes} class="dark" />}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.oryn-shot {
		margin-block: 1.5rem;
	}
	.oryn-shot img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
	.oryn-shot.single img {
		border: 1px solid var(--sl-color-gray-5);
	}
	:root[data-theme='light'] .oryn-shot:not(.single) .dark,
	:root[data-theme='dark'] .oryn-shot:not(.single) .light {
		display: none;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
